@model HomeMedicineCabinet.UI.Models.MedicineStockCreateViewModel

@{
    ViewData["Title"] = "Добавить запас";
}

<h1>Добавить запас</h1>

<h4>@ViewBag.MedicineName</h4>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="MedicineId" />

    <div class="mb-3">
        <label class="form-label">Количество</label>
        <input asp-for="Quantity" class="form-control" type="number" step="0.25" />
        <small class="text-muted">
            Базовая единица: @ViewBag.BaseUnit
        </small>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsPackage" class="form-check-input" id="isPackageCheckbox" type="checkbox" />
        <label asp-for="IsPackage" class="form-check-label">
            Добавляю упаковками
        </label>
    </div>

    <div class="mb-3">
        <label asp-for="ItemsPerPackage" class="form-label">
            Сколько базовых единиц в одной упаковке
        </label>
        <input asp-for="ItemsPerPackage"
               id="itemsPerPackageInput"
               class="form-control"
               type="number"
               readonly />
        <small class="text-muted">
            Например: 1 упаковка = 10 @ViewBag.BaseUnit
        </small>
    </div>

    <div class="mb-3">
        <label class="form-label">Минимальный остаток</label>
        <input asp-for="MinQuantity" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label class="form-label">Срок годности</label>
        <input asp-for="ExpirationDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Место хранения</label>
        <input asp-for="StoragePlace" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Сохранить</button>
    <a asp-controller="Medicines" asp-action="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <script>
        const checkbox = document.getElementById("isPackageCheckbox");
        const input = document.getElementById("itemsPerPackageInput");

        function toggleItemsPerPackage() {
            input.readOnly = !checkbox.checked;

            if (!checkbox.checked) {
                input.value = "";
            }
        }

        checkbox.addEventListener("change", toggleItemsPerPackage);

        toggleItemsPerPackage();
    </script>
}