@model IEnumerable<HomeMedicineCabinet.Core.Entities.Notification>

@{
    ViewData["Title"] = "Уведомления";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Уведомления</h2>

    <form asp-action="MarkAllAsRead" method="post">
        <button type="submit" class="btn btn-outline-primary">
            Отметить все как прочитанные
        </button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Уведомлений пока нет.
    </div>
}
else
{
    <div class="list-group">
        @foreach (var notification in Model)
        {
            <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-warning")">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="mb-1">@notification.Title</h5>
                        <p class="mb-1">@notification.Message</p>

                        @if (notification.Medicine != null)
                        {
                            <small class="text-muted">
                                Лекарство: @notification.Medicine.Name
                            </small>
                            <br />
                        }

                        <small class="text-muted">
                            Создано: @notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </small>

                        @if (notification.SentAt != null)
                        {
                            <br />
                            <small class="text-muted">
                                Отправлено: @notification.SentAt?.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        }
                    </div>

                    <div>
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post">
                                <input type="hidden" name="id" value="@notification.Id" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    Прочитано
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Прочитано</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}