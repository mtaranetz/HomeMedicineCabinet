@model IEnumerable<HomeMedicineCabinet.Core.Entities.IntakeSchedule>

@{
    ViewData["Title"] = "Расписание приёма";
}

<h1>Расписание приёма</h1>

<a class="btn btn-primary mb-3" asp-action="Create">
    Добавить расписание
</a>

<a class="btn btn-secondary mb-3" asp-controller="Medicines" asp-action="Index">
    Назад к аптечке
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Лекарство</th>
            <th>Доза</th>
            <th>Периодичность</th>
            <th>Время</th>
            <th>Период</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var schedule in Model)
        {
            <tr>
                <td>@schedule.Medicine.Name</td>
                <td>@schedule.Dose</td>
                <td>@schedule.FrequencyType</td>
                <td>
                    @string.Join(", ", schedule.IntakeTimes.Select(t => t.IntakeTimeValue.ToString(@"hh\:mm")))
                </td>
                <td>
                    @schedule.StartDate.ToString("dd.MM.yyyy")
                    @if (schedule.EndDate != null)
                    {
                        <span> — @schedule.EndDate.Value.ToString("dd.MM.yyyy")</span>
                    }
                </td>
                <td>
                    @if (schedule.IsActive)
                    {
                        <span class="badge bg-success">Активно</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Отключено</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>