@model IEnumerable<HomeMedicineCabinet.Core.Entities.MedicineStock>

@{
    ViewData["Title"] = "Контроль сроков годности";
    var today = DateTime.Today;
}

<h1>Контроль сроков годности</h1>

<a asp-action="Index" class="btn btn-secondary mb-3">Назад к аптечке</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Лекарство</th>
            <th>Категория</th>
            <th>Количество</th>
            <th>Срок годности</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in Model)
        {
            var isExpired = stock.ExpirationDate.Date < today;
            var status = isExpired ? "Просрочено" : "Скоро истекает";

            <tr>
                <td>@stock.Medicine.Name</td>
                <td>@stock.Medicine.Category?.Name</td>
                <td>@stock.Quantity @stock.Unit</td>
                <td>@stock.ExpirationDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (isExpired)
                    {
                        <span class="badge bg-danger">@status</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@status</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>