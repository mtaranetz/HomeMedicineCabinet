@model IEnumerable<HomeMedicineCabinet.Core.Entities.Medicine>

@{
    ViewData["Title"] = "Моя аптечка";
}

<h1>Моя аптечка</h1>

<a class="btn btn-primary mb-3" asp-controller="Medicines" asp-action="Create">
    Добавить лекарство
</a>

<a class="btn btn-warning mb-3"
       asp-controller="Medicines"
       asp-action="Expiration">
    Проверить сроки годности
</a>

<a class="btn btn-danger mb-3"
       asp-controller="Medicines"
       asp-action="LowStock">
    Низкие запасы
</a>

<a class="btn btn-info mb-3"
       asp-controller="Schedules"
       asp-action="Index">
    Расписание приёма
</a>

<a class="btn btn-success mb-3"
       asp-controller="IntakeLogs"
       asp-action="Index">
    Журнал приёма
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Категория</th>
            <th>Форма</th>
            <th>Дозировка</th>
            <th>Запасы</th>
            <th>Срок годности</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var medicine in Model)
    {
        var firstStock = medicine.Stocks.FirstOrDefault();

        <tr>
            <td>@medicine.Name</td>
            <td>@medicine.Category?.Name</td>
            <td>@medicine.Form</td>
            <td>@medicine.Dosage</td>
            <td>
                @if (firstStock != null)
                {
                    @($"{firstStock.Quantity} {firstStock.Unit}")
                }
                else
                {
                    <span>Нет данных</span>
                }
            </td>
            <td>
                @if (firstStock != null)
                {
                    @firstStock.ExpirationDate.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span>Нет данных</span>
                }
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary"
                        asp-controller="MedicineStocks"
                        asp-action="Create"
                        asp-route-medicineId="@medicine.Id">
                    Добавить запас
                </a>
            
                <a class="btn btn-sm btn-outline-secondary"
                        asp-controller="Medicines"
                        asp-action="Edit"
                        asp-route-id="@medicine.Id">
                    Редактировать
                </a>

                <form asp-controller="Medicines"
                        asp-action="Delete"
                        asp-route-id="@medicine.Id"
                        method="post"
                        style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        Удалить
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>